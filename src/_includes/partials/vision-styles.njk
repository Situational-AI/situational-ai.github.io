    .cta-reason h4 {
      font-size: 0.95rem;
      font-weight: 600;
      margin-bottom: 8px;
      color: var(--color-text);
    }
    .cta-reason p {
      font-size: 0.9rem;
      color: var(--color-text-muted);
      margin: 0;
      line-height: 1.5;
    }
    .cta-buttons {
      display: flex;
      gap: 16px;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 40px;
    }

    .vision-centered {
      text-align: center;
      padding: 80px 0;
      border-top: 1px solid var(--color-border);
    }
