      font-size: clamp(1.6rem, 3.5vw, 2.4rem);
      font-weight: 700;
      margin-bottom: 20px;
    }
    .vision-centered p {
      color: var(--color-text-muted);
      font-size: 1.05rem;
      line-height: 1.8;
      max-width: 700px;
      margin: 0 auto 16px;
    }
    .vision-centered img {
      max-width: 500px;
      width: 100%;
      border-radius: var(--radius-lg);
      border: 1px solid var(--color-border);
      margin-top: 32px;
    }

    /* Videos placeholder */
    .video-section {
      text-align: center;
      padding: 80px 0;
      background: var(--color-bg-alt);
      border-top: 1px solid var(--color-border);
    }
    .video-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      max-width: 900px;
      margin: 40px auto 0;
    }
    .video-embed {
      position: relative;
      padding-bottom: 56.25%;
      border-radius: var(--radius);
      overflow: hidden;
      border: 1px solid var(--color-border);
      background: var(--color-surface);
    }
    .video-embed iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    .video-placeholder-msg {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--color-text-muted);
      font-size: 0.9rem;
    }

    @media (max-width: 768px) {
      .vision-row {
        grid-template-columns: 1fr;
        gap: 32px;
      }
      .vision-row.reverse .vision-text { order: 1; }
      .vision-row.reverse .vision-media { order: 2; }
      .timeline {
        gap: 0;
      }
      .timeline-card {
        width: 140px;
      }
      .timeline-card img {
        height: 80px;
      }
      .timeline-arrow {
        font-size: 0.9rem;
        padding: 0 4px;
      }
      .video-grid {
        grid-template-columns: 1fr;
      }
      .vision-hero-image {
        max-width: 300px;
