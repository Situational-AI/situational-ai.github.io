<style>
    .vision-hero {
      min-height: 80vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 140px 0 80px;
      position: relative;
    }
    .vision-hero .hero-bg {
      position: absolute;
      inset: 0;
      background:
        radial-gradient(ellipse 80% 60% at 50% 0%, rgba(35, 151, 248, 0.15) 0%, transparent 60%),
        radial-gradient(ellipse 60% 50% at 80% 50%, rgba(244, 162, 97, 0.08) 0%, transparent 50%);
      pointer-events: none;
    }
    .vision-hero-content { position: relative; z-index: 1; }
    .vision-hero-image {
      max-width: 500px;
      width: 100%;
      margin: 0 auto 32px;
      border-radius: var(--radius-lg);
    }

    .vision-section {
      padding: 80px 0;
      border-top: 1px solid var(--color-border);
    }
    .vision-section:nth-child(even) {
      background: var(--color-bg-alt);
    }

    .vision-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }
    .vision-row.reverse .vision-text { order: 2; }
    .vision-row.reverse .vision-media { order: 1; }

    .vision-text h2 {
      font-size: clamp(1.6rem, 3.5vw, 2.4rem);
      font-weight: 700;
      margin-bottom: 20px;
      letter-spacing: -0.01em;
    }
    .vision-text p {
      color: var(--color-text-muted);
      font-size: 1.05rem;
      line-height: 1.8;
      margin-bottom: 16px;
    }
    .vision-text ul {
      list-style: none;
      padding: 0;
      margin: 16px 0;
    }
    .vision-text li {
      color: var(--color-text-muted);
      font-size: 1rem;
      line-height: 1.7;
      padding: 6px 0 6px 24px;
      position: relative;
    }
    .vision-text li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 14px;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    }

    .vision-media img {
      width: 100%;
      border-radius: var(--radius-lg);
      border: 1px solid var(--color-border);
    }

    /* Timeline Cards */
    .timeline {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0;
      margin: 40px 0;
      flex-wrap: wrap;
    }
    .timeline-card {
      text-align: center;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      transition: var(--transition);
      width: 200px;
      overflow: hidden;
    }
    .timeline-card:hover {
      border-color: var(--color-primary);
      transform: translateY(-4px);
    }
    .timeline-card.active {
      border-color: var(--color-accent);
      background: rgba(244, 162, 97, 0.06);
    }
    .timeline-card img {
      width: 100%;
      height: 130px;
      object-fit: cover;
      display: block;
    }
    .timeline-card-text {
      padding: 12px 12px 16px;
    }
    .timeline-card .era {
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--color-primary-light);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 4px;
    }
    .timeline-card .label {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--color-text-muted);
    }
    .timeline-card.active .label {
      color: var(--color-accent);
    }
    .timeline-arrow {
      font-size: 1.2rem;
      color: var(--color-text-muted);
      padding: 0 8px;
      opacity: 0.5;
    }

