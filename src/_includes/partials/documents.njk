{#- Embedded PDFs. Desktop browsers render them inline; phones and tablets
    can't do that reliably, so they get a card that opens the file instead.
    Driven by a person's or project's `documents` array. -#}
{%- for doc in documents %}
<section class="doc">
  <div class="doc-head">
    <div>
      {%- if doc.kind %}<p class="doc-kind">{{ doc.kind }}</p>{% endif %}
      <h3 class="doc-title">{{ doc.title }}</h3>
      {%- if doc.meta %}<p class="doc-meta">{{ doc.meta }}</p>{% endif %}
    </div>
    <div class="doc-actions">
      <a href="{{ doc.file }}" class="btn btn-outline btn-sm" target="_blank" rel="noopener">Full screen &nearr;</a>
      <a href="{{ doc.file }}" class="btn btn-outline btn-sm" download>Download</a>
    </div>
  </div>
  <div class="doc-frame">
    <iframe src="{{ doc.file }}#view=FitH" title="{{ doc.title }}" loading="lazy"></iframe>
  </div>
  <p class="doc-onfile">
    <a href="{{ doc.file }}" target="_blank" rel="noopener">Open “{{ doc.title }}” (PDF{% if doc.pages %}, {{ doc.pages }} pages{% endif %})</a>
    <span>Inline preview needs a desktop browser.</span>
  </p>
  {%- if doc.note %}<p class="doc-note">{{ doc.note }}</p>{% endif %}
</section>
{%- endfor %}
