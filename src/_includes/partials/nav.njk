{#- Site navigation. `nav` in a page's front matter names the active item. -#}
<nav class="navbar{% if navbarScrolled %} scrolled{% endif %}" id="navbar">
  <div class="container nav-container">
    <a href="/" class="nav-logo"><img src="/assets/images/situational-ai-logo.png" alt="Situational AI"></a>
    <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation"><span></span><span></span><span></span></button>
    <ul class="nav-links" id="navLinks">
      {%- for item in site.nav %}
      <li><a href="{{ item.url }}"{% if nav == item.key %} class="active" aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {%- endfor %}
    </ul>
    <div class="nav-actions">
      <a href="{{ site.manifesto }}" class="btn btn-nav" target="_blank" rel="noopener">Manifesto</a>
    </div>
  </div>
  {%- set current = events | bySlug(site.currentEvent) %}
  {%- if current and not hideAnnounce %}
  {#- One line under the bar, on every page that has no RSVP of its own. Hidden by events.js once the event is archived. -#}
  <div class="nav-announce event-register-only">
    <a href="{{ current.url }}" class="nav-announce-label"><span class="hero-pill-dot" aria-hidden="true"></span><span class="nav-announce-full">{{ current.title }} · {{ current.dateLabel }}</span><span class="nav-announce-short">{{ current.kind }} · {{ current.dateLabel }}</span></a>
    <a href="https://luma.com/7jhkvaz2" data-rsvp="{{ current.slug }}" class="nav-announce-cta" target="_blank" rel="noopener">RSVP &rarr;</a>
  </div>
  {%- endif %}
</nav>
