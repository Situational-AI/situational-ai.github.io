<footer class="footer">
  <div class="container">
    <div class="footer-content footer-content--program">
      <div class="footer-brand">
        <a href="/"><img src="/assets/images/situational-ai-logo.png" alt="Situational AI" style="height:24px; border-radius:4px;"></a>
        <p class="footer-attribution">{{ site.attribution }}</p>
        <p class="footer-note">{{ site.affiliationNote }}</p>
        <div class="footer-follow" id="follow">
          <p class="footer-follow-label">Follow the Inquiry</p>
          <p class="footer-follow-text">New essays, experiments, research questions, student work and gatherings. No marketing.</p>
          <form class="follow-form follow-form--footer" action="{{ forms.follow.action }}" method="POST" data-google-form data-success="footerFollowSuccess">
            <label for="footer-follow-email" class="visually-hidden">Email</label>
            <input id="footer-follow-email" name="{{ forms.follow.fields.email }}" type="email" placeholder="you@example.com" autocomplete="email" required>
            <button type="submit" class="btn btn-outline btn-sm">Follow</button>
          </form>
          <p class="form-success form-success--small" id="footerFollowSuccess" hidden>You’re following. We’ll write when there is something worth reading.</p>
        </div>
      </div>
      <ul class="footer-links">
        {%- for item in site.footerNav %}
        <li><a href="{{ item.url }}"{% if item.external %} target="_blank" rel="noopener"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </div>
    <div class="footer-meta">
      <p class="footer-text">&copy; {{ site.year }} Mindspace AI LLC. All rights reserved.</p>
      <p class="footer-text footer-secondary"><a href="https://mindspaceai.com/" target="_blank" rel="noopener">Mindspace AI</a> · <a href="https://www.botswork.ai" target="_blank" rel="noopener">BotsWork</a></p>
    </div>
  </div>
</footer>
